  quizQuestions:
  - question: "\u0429\u043E \u0434\u043E\u0441\u043B\u0456\u0434\u0436\u0443\u0454\u0442\u044C\u0441\u044F
      \u0432 \u043B\u0430\u0431\u043E\u0440\u0430\u0442\u043E\u0440\u043D\u0456\u0439
      \u0440\u043E\u0431\u043E\u0442\u0456 \xAB\u041C\u0430\u0448\u0438\u043D\u0430
      \u0410\u0442\u0432\u0443\u0434\u0430\xBB?"
    options:
    - "\u0420\u0456\u0432\u043D\u043E\u043F\u0440\u0438\u0441\u043A\u043E\u0440\u0435\u043D\u0438\u0439
      \u0440\u0443\u0445 \u0442\u0430 \u043F\u0435\u0440\u0435\u0432\u0456\u0440\u043A\u0430
      \u0434\u0440\u0443\u0433\u043E\u0433\u043E \u0437\u0430\u043A\u043E\u043D\u0443
      \u041D\u044C\u044E\u0442\u043E\u043D\u0430"
    - "\u0417\u0430\u043A\u043E\u043D \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043D\u043D\u044F
      \u0456\u043C\u043F\u0443\u043B\u044C\u0441\u0443 \u043F\u0440\u0438 \u043F\u0440\u0443\u0436\u043D\u043E\u043C\u0443
      \u0443\u0434\u0430\u0440\u0456"
    - "\u041A\u043E\u043B\u0438\u0432\u0430\u043D\u043D\u044F \u043C\u0430\u0442\u0435\u043C\u0430\u0442\u0438\u0447\u043D\u043E\u0433\u043E
      \u043C\u0430\u044F\u0442\u043D\u0438\u043A\u0430"
    - "\u0412\u0438\u0437\u043D\u0430\u0447\u0435\u043D\u043D\u044F \u043A\u043E\u0435\u0444\u0456\u0446\u0456\u0454\u043D\u0442\u0430
      \u0442\u0435\u0440\u0442\u044F \u043A\u043E\u0432\u0437\u0430\u043D\u043D\u044F"
    correctIndex: 0
  - question: "\u0429\u043E \u0442\u0430\u043A\u0435 \u043C\u0430\u0448\u0438\u043D\u0430
      \u0410\u0442\u0432\u0443\u0434\u0430?"
    options:
    - "\u041F\u0440\u0438\u043B\u0430\u0434 \u0434\u043B\u044F \u0432\u0438\u043C\u0456\u0440\u044E\u0432\u0430\u043D\u043D\u044F
      \u0441\u0438\u043B\u0438 \u0442\u044F\u0436\u0456\u043D\u043D\u044F"
    - "\u0414\u0432\u0430 \u0442\u044F\u0433\u0430\u0440\u0446\u0456 \u043E\u0434\u043D\u0430\u043A\u043E\u0432\u043E\u0457
      \u043C\u0430\u0441\u0438, \u0437'\u0454\u0434\u043D\u0430\u043D\u0456 \u043D\u0438\u0442\u043A\u043E\u044E
      \u0447\u0435\u0440\u0435\u0437 \u043D\u0435\u0440\u0443\u0445\u043E\u043C\u0438\u0439
      \u0431\u043B\u043E\u043A"
    - "\u041F\u0440\u0438\u0441\u0442\u0440\u0456\u0439 \u0434\u043B\u044F \u0432\u0438\u0437\u043D\u0430\u0447\u0435\u043D\u043D\u044F
      \u0448\u0432\u0438\u0434\u043A\u043E\u0441\u0442\u0456 \u0437\u0432\u0443\u043A\u0443"
    - "\u041F\u0440\u0438\u0441\u0442\u0440\u0456\u0439 \u0434\u043B\u044F \u0432\u0438\u0437\u043D\u0430\u0447\u0435\u043D\u043D\u044F
      \u043A\u043E\u0435\u0444\u0456\u0446\u0456\u0454\u043D\u0442\u0430 \u043F\u0440\u0443\u0436\u043D\u043E\u0441\u0442\u0456"
    correctIndex: 1
  - question: "\u042F\u043A\u0430 \u0442\u0435\u043E\u0440\u0435\u0442\u0438\u0447\u043D\u0430
      \u0444\u043E\u0440\u043C\u0443\u043B\u0430 \u043F\u0440\u0438\u0441\u043A\u043E\u0440\u0435\u043D\u043D\u044F
      \u0432 \u043C\u0430\u0448\u0438\u043D\u0456 \u0410\u0442\u0432\u0443\u0434\u0430?"
    options:
    - "\u0101 = m<sub>1</sub> \xB7 g / (2m + m<sub>1</sub>)"
    - "\u0101 = S<sub>2</sub><sup>2</sup> / (2 \xB7 S<sub>1</sub> \xB7 t<sub>2</sub><sup>2</sup>)"
    - "\u0101 = (m<sub>1</sub> + m) \xB7 g / 2"
    - "\u0101 = 2S \xB7 g / v<sup>2</sup>"
    correctIndex: 0
  - question: "\u042F\u043A\u0430 \u0444\u043E\u0440\u043C\u0443\u043B\u0430 \u0440\u043E\u0437\u0440\u0430\u0445\u0443\u043D\u043A\u0443
      \u043F\u0440\u0438\u0441\u043A\u043E\u0440\u0435\u043D\u043D\u044F \u0437\u0430
      \u0434\u043E\u0441\u043B\u0456\u0434\u043D\u0438\u043C\u0438 \u0434\u0430\u043D\u0438\u043C\u0438?"
    options:
    - "\u0101 = S<sub>2</sub> \xB7 t<sub>2</sub> / (2 \xB7 S<sub>1</sub>)"
    - "\u0101 = S<sub>2</sub><sup>2</sup> / (2 \xB7 S<sub>1</sub> \xB7 t<sub>2</sub><sup>2</sup>)"
    - "\u0101 = 2 \xB7 S<sub>1</sub> / (S<sub>2</sub> \xB7 t<sub>2</sub><sup>2</sup>)"
    - "\u0101 = (S<sub>2</sub> - S<sub>1</sub>) / t<sub>2</sub><sup>2</sup>"
